EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
EXPO_PUBLIC_APP_ORIGIN=https://intown.dev

# Google OAuth credentials are configured in Supabase Authentication > Providers.
# Add intown:///auth/callback and your web origin + /auth/callback to
# Supabase Authentication > URL Configuration > Redirect URLs.

# Google Calendar Sync (PRA-7). OAuth client that authorizes calendar access
# for status automation — separate from the Supabase sign-in provider above.
# Use an iOS/Android/Desktop ("installed app") OAuth client so the app can use
# PKCE without shipping a client secret. Register intown:///auth/google-calendar
# (and your web origin + /auth/google-calendar) as an authorized redirect URI,
# and enable the Google Calendar API for the project.
# When unset, the connection flow is simulated in dev and disabled in prod.
EXPO_PUBLIC_GOOGLE_CALENDAR_CLIENT_ID=your-google-oauth-client-id
